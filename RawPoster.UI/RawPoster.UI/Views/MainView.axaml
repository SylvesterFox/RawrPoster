<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:post="using:RawPoster.UI.Views.Post"
    x:Class="RawPoster.UI.Views.MainView"
    SizeChanged="MainViewSizeChanged">

    <Grid RowDefinitions="64,*">

        <!-- ====================================================== -->
        <!-- TOP BAR                                                -->
        <!-- ====================================================== -->

        <Border
            Grid.Row="0"
            BorderBrush="#404040"
            BorderThickness="0,0,0,1"
            Padding="16,0">

            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- Mobile menu -->
                <Button
                    x:Name="MenuButton"
                    Grid.Column="0"
                    Content="☰"
                    Width="42"
                    Height="42"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    IsVisible="False"
                    Padding="0, 10, 0, 10"
                    Click="MenuButtonClick"/>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="RawrPoster"
                        FontSize="20"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Telegram post editor"
                        FontSize="12"
                        Opacity="0.6"/>

                </StackPanel>

                <!-- Bot status -->

                <StackPanel
                    x:Name="BotStatus"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">

                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="#4CAF50"/>

                    <TextBlock
                        Text="Bot connected"
                        VerticalAlignment="Center"
                        Opacity="0.75"/>

                </StackPanel>

                <!-- Settings -->

                <Button
                    Grid.Column="3"
                    Content="⚙"
                    Width="42"
                    Height="42"
                    Padding="1, 10, 0, 10"
                    VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- BODY                                                    -->
        <!-- ====================================================== -->

        <Grid
            x:Name="BodyGrid"
            Grid.Row="1"
            ColumnDefinitions="246,*"
            >

            <!-- ================================================== -->
            <!-- SIDEBAR                                             -->
            <!-- ================================================== -->

            <Border
                x:Name="Sidebar"
                Grid.Column="0"
                Width="230"
                Margin="16"
                HorizontalAlignment="Left"
                Padding="14"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="12"
                ZIndex="10"
                Background="#404040">

                <Grid RowDefinitions="Auto,Auto,*">

                    <StackPanel
                        Grid.Row="0"
                        Spacing="7">

                        <TextBlock
                            Text="Основные"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4"/>

                        <Button
                            Grid.Row="0"
                            Content="＋ Новый пост"
                            HorizontalContentAlignment="Left"/>

                        <Button
                            Content="Создать шаблон"
                            HorizontalContentAlignment="Left"/>

                        <Button
                            Content="Список шаблонов"
                            HorizontalContentAlignment="Left"/>

                        <Button
                             Content="Отложенные посты"
                             HorizontalContentAlignment="Left"/>


                    </StackPanel>



                    <StackPanel
                        Grid.Row="2"
                        VerticalAlignment="Bottom"
                        Spacing="5">

                        <TextBlock
                            Text="Дополнительно"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6"/>

                        <Button
                            Content="#  Хэштеги"
                            HorizontalContentAlignment="Left"/>

                        <Button
                            Content="◷  История"
                            HorizontalContentAlignment="Left"/>

                        <Button
                            Content="⚙  Настройки"
                            HorizontalContentAlignment="Left"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- CONTENT                                     -->
            <!-- ================================================== -->

            <post:CreatePostView
                x:Name="CreatePostView"
                Grid.Column="1"
                Margin="30,16,30,16"/>


        </Grid>

    </Grid>

</UserControl>